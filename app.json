{
  "expo": {
    "name": "Weedly",
    "slug": "weedly",
    "scheme": "weedly",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121412",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agus.weedly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.agus.weedly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#121412"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Weedly usa tus fotos para guardar el seguimiento de cada planta.",
          "cameraPermission": "Weedly usa la cámara para sacar fotos de tus plantas."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#121412"
        }
      ]
    ]
  }
}
